{
  "build": {
    "env": {
      "HUGO_VERSION": "0.162.1"
    }
  },
  "buildCommand": "hugo --gc --minify --baseURL https://mirohentai.fun/",
  "outputDirectory": "public",
  "installCommand": "",
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.mirohentai.fun"
        }
      ],
      "destination": "https://mirohentai.fun/:path*",
      "permanent": true
    }
  ]
}
